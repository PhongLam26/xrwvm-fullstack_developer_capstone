FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM mongo:7.0
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
ENV PORT=3030 MONGO_URL=mongodb://127.0.0.1:27017/dealershipsDB
EXPOSE 3030
CMD ["sh", "-c", "mongod --dbpath /data/db --bind_ip 127.0.0.1 --fork --logpath /tmp/mongodb.log && exec node app.js"]
